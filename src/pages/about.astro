---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { profile } from '../data/profile';
---
<BaseLayout title="About me">
  <header class="page-heading">
    <h1>About me</h1>
    <p class="page-lead">{profile.name}<br />{profile.education}</p>
  </header>
  <div class="about-grid">
    <section class="prose about-text" aria-labelledby="background">
      <h2 id="background">Background</h2>
      <p>{profile.introduction}</p>
      {profile.about.map((paragraph) => <p class="placeholder">{paragraph}</p>)}
    </section>
    {profile.contactLinks.some(({ href }) => href.trim()) && <aside class="contact-panel" id="contact" aria-labelledby="contact-title">
      <h2 id="contact-title">Contact</h2>
      <ContactLinks />
    </aside>}
  </div>
</BaseLayout>
