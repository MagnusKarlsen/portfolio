---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { profile } from '../data/profile';
---
<BaseLayout title="About me">
  <header class="page-heading">
    <p class="eyebrow">Background and contact</p>
    <h1>About me</h1>
    <p class="page-lead">{profile.name}<br />{profile.education}</p>
  </header>
  <div class="about-grid">
    <section class="prose about-text" aria-labelledby="background">
      <h2 id="background">A little about me</h2>
      {profile.about.map((paragraph) => <p class="placeholder">{paragraph}</p>)}
      <h2>Areas of interest</h2>
      <p>{profile.interests.join(', ')}</p>
    </section>
    <aside class="contact-panel" id="contact" aria-labelledby="contact-title">
      <p class="eyebrow">Get in touch</p>
      <h2 id="contact-title">Contact</h2>
      <ContactLinks />
    </aside>
  </div>
</BaseLayout>
