---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../../config/site.mjs';
---
<BaseLayout title="Page not found" noindex>
  <section class="page-heading error-page">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p class="page-lead">The link may have changed, or this project has not been published.</p>
    <a class="text-link" href={withBase()}>Back to home <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
