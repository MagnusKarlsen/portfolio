---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../data/profile';
import { getPublishedProjects } from '../lib/projects';
import { withBase } from '../../config/site.mjs';

const projects = await getPublishedProjects();
---
<BaseLayout>
  <section class="intro" aria-labelledby="introduction">
    <div class="intro-main">
      <p class="eyebrow">Personal project portfolio</p>
      <h1 id="introduction">{profile.name}</h1>
      <p class="education">{profile.education}</p>
      <p class="intro-text placeholder">{profile.introduction}</p>
      <a class="text-link" href={withBase('about/')}>More about me <span aria-hidden="true">↗</span></a>
    </div>
    <aside class="interests" aria-label="Areas of interest">
      <p class="eyebrow">Areas of interest</p>
      <ul role="list">{profile.interests.map((interest) => <li>{interest}</li>)}</ul>
    </aside>
  </section>

  <section class="projects-section" aria-labelledby="projects">
    <div class="section-heading">
      <div><p class="eyebrow">Project archive</p><h2 id="projects">Projects</h2></div>
      <p class="section-note">Overview and documentation</p>
    </div>
    {projects.length ? (
      <div class="project-grid">{projects.map((project) => <ProjectCard project={project} />)}</div>
    ) : (
      <div class="empty-state">
        <span class="empty-mark" aria-hidden="true">＋</span>
        <h3>Projects coming soon</h3>
        <p>No projects have been published yet.</p>
      </div>
    )}
  </section>
</BaseLayout>
