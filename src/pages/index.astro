---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import ContactLinks from '../components/ContactLinks.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../data/profile';
import { getPublishedProjects } from '../lib/projects';

const projects = await getPublishedProjects();
---
<BaseLayout>
  <section class="profile-intro" aria-labelledby="introduction">
    <div class="profile-heading">
      <Image class="profile-portrait" src={profile.portrait.src} alt={profile.portrait.alt} width={224} height={224} format="webp" quality={85} loading="eager" fetchpriority="high" />
      <div>
        <h1 id="introduction">{profile.name}</h1>
        <p class="education">{profile.education}</p>
      </div>
    </div>
    <div class="profile-about" id="about">
      <h2>About me</h2>
      <p>{profile.introduction}</p>
      <ContactLinks />
    </div>
  </section>

  <section class="projects-section" aria-labelledby="projects">
    <h2 id="projects">Projects</h2>
    {projects.length ? (
      <div class="project-grid">{projects.map((project) => <ProjectCard project={project} />)}</div>
    ) : (
      <div class="empty-state">
        <span class="empty-mark" aria-hidden="true">＋</span>
        <h3>Projects coming soon</h3>
        <p>No projects have been published yet.</p>
      </div>
    )}
  </section>
</BaseLayout>
