---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ProjectImage from './ProjectImage.astro';
import { withBase } from '../../config/site.mjs';

interface Photo {
  src: ImageMetadata | string;
  alt: string;
  caption?: string | undefined;
}
interface Props { images: Photo[] }
const { images: sourceImages } = Astro.props;
const images = await Promise.all(sourceImages.map(async (photo) => ({
  ...photo,
  full: typeof photo.src === 'string' ? withBase(photo.src) : (await getImage({
    src: photo.src, width: Math.min(photo.src.width, 1920), format: photo.src.format === 'svg' ? 'svg' : 'webp',
  })).src,
})));
---
<section class="project-gallery" data-project-gallery aria-label="Project photos">
  <div class:list={['gallery-images', { 'gallery-single': images.length === 1 }]} style={`--gallery-columns: ${Math.min(images.length, 3)}`}>
    {images.map((photo, index) => (
      <figure class="gallery-item">
        <a href={photo.full} target="_blank" rel="noopener" data-gallery-item data-alt={photo.alt} data-caption={photo.caption ?? ''} aria-label={`Enlarge photo ${index + 1}: ${photo.alt}`}>
          <ProjectImage src={photo.src} alt={photo.alt} width={images.length === 1 ? 1600 : 960} eager={index === 0} />
        </a>
        {photo.caption && <figcaption>{photo.caption}</figcaption>}
      </figure>
    ))}
  </div>
  <p class="gallery-help">Select a photo to enlarge.</p>
  <dialog class="gallery-lightbox" aria-label="Enlarged project photo">
    <div class="lightbox-toolbar">
      <span data-gallery-counter aria-live="polite"></span>
      <button type="button" data-gallery-close aria-label="Close enlarged photo">Close <span aria-hidden="true">×</span></button>
    </div>
    <figure>
      <div class="lightbox-stage" data-gallery-stage></div>
      <figcaption data-gallery-caption></figcaption>
    </figure>
    <div class="lightbox-controls">
      <button type="button" data-gallery-previous hidden={images.length < 2}><span aria-hidden="true">←</span> Previous</button>
      <button type="button" data-gallery-next hidden={images.length < 2}>Next <span aria-hidden="true">→</span></button>
    </div>
  </dialog>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-project-gallery]').forEach((gallery) => {
    const dialog = gallery.querySelector<HTMLDialogElement>('dialog')!;
    if (typeof dialog.showModal !== 'function') return;
    const links = [...gallery.querySelectorAll<HTMLAnchorElement>('[data-gallery-item]')];
    const stage = gallery.querySelector<HTMLElement>('[data-gallery-stage]')!;
    const caption = gallery.querySelector<HTMLElement>('[data-gallery-caption]')!;
    const counter = gallery.querySelector<HTMLElement>('[data-gallery-counter]')!;
    const image = document.createElement('img');
    let current = 0;
    let activeLink: HTMLAnchorElement | null = null;

    function show(index: number) {
      current = (index + links.length) % links.length;
      const link = links[current]!;
      image.alt = link.dataset.alt ?? '';
      image.src = link.href;
      stage.replaceChildren(image);
      caption.textContent = link.dataset.caption || image.alt;
      counter.textContent = `${current + 1} / ${links.length}`;
    }

    links.forEach((link, index) => link.addEventListener('click', (event) => {
      if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      activeLink = link;
      show(index);
      dialog.showModal();
      document.documentElement.classList.add('gallery-is-open');
    }));
    gallery.querySelector('[data-gallery-close]')!.addEventListener('click', () => dialog.close());
    gallery.querySelector('[data-gallery-previous]')!.addEventListener('click', () => show(current - 1));
    gallery.querySelector('[data-gallery-next]')!.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('keydown', (event) => {
      if (links.length < 2 || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
      event.preventDefault();
      show(current + (event.key === 'ArrowRight' ? 1 : -1));
    });
    dialog.addEventListener('click', (event) => {
      if (event.target !== dialog) return;
      const bounds = dialog.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
    });
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('gallery-is-open');
      stage.replaceChildren();
      activeLink?.focus();
    });
  });
</script>
