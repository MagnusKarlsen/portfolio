---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { withBase } from '../../config/site.mjs';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  eager?: boolean;
}
const { src, alt, eager = false } = Astro.props;
---
{typeof src === 'string' ? (
  <img src={withBase(src)} alt={alt} width="1200" height="800" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
) : (
  <Image src={src} alt={alt} width={Math.min(src.width, 1600)} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
)}
