---
import { profile } from '../data/profile';
const links = profile.contactLinks.filter(({ href }) => href.trim());
---
{links.length > 0 && (
  <ul class="contact-links" role="list">
    {links.map(({ label, href }) => <li><a href={href}>{label}<span aria-hidden="true"> ↗</span></a></li>)}
  </ul>
)}
