---
import { profile } from '../data/profile';
import { withBase } from '../../config/site.mjs';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = profile.description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} · Project portfolio`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const isAbout = Astro.url.pathname === withBase('about/');
const initials = profile.name.split(/\s+/).map((part) => part[0]).slice(0, 2).join('');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f7f4" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{pageTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header container">
      <a class="brand" href={withBase()} aria-label={`${profile.name} – home`}>
        <span class="brand-mark" aria-hidden="true">{initials}</span>
        <span>{profile.name}</span>
      </a>
      <nav aria-label="Main navigation">
        <a href={withBase()} aria-current={!isAbout ? 'page' : undefined}>Projects</a>
        <a href={withBase('about/')} aria-current={isAbout ? 'page' : undefined}>About me</a>
      </nav>
    </header>
    <main id="main-content" class="container" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer container">
      <span>{profile.name}</span>
      <span>Personal project portfolio</span>
      <a href={withBase('about/#contact')}>Contact</a>
    </footer>
  </body>
</html>
